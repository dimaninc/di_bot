{
    "name": "dimaninc/di_bot",
    "description": "Telegram and MAX bot transport without framework or database dependencies",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "psr/log": "^3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "diBot\\": "src/diBot/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "diBot\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
